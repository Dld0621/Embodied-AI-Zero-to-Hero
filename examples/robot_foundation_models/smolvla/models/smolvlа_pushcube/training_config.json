{
  "batch_size": 4,
  "learning_rate": 0.0001,
  "epochs": 2,
  "chunk_size": 10,
  "temporal_ensemble": true,
  "augmentation": true,
  "save_every": 10,
  "device": "cuda",
  "model": {
    "pretrained_name_or_path": "lerobot/smolvla_base"
  },
  "dataset": {
    "repo_id": "local/pushcube_demo",
    "root": "data/pushcube_lerobot",
    "episodes": null,
    "image_keys": [
      "observation.images.front"
    ],
    "state_key": "observation.state",
    "action_key": "action",
    "language_key": "task"
  },
  "training": {
    "batch_size": 16,
    "num_workers": 4,
    "num_epochs": 50,
    "learning_rate": 0.0001,
    "weight_decay": 0.01,
    "warmup_steps": 500,
    "lr_scheduler": "cosine",
    "grad_clip_norm": 1.0,
    "chunk_size": 10,
    "temporal_ensemble": {
      "enabled": true,
      "decay": 0.01
    },
    "augment": {
      "brightness": 0.1,
      "contrast": 0.1,
      "saturation": 0.1,
      "hue": 0.05,
      "random_crop": true
    }
  },
  "hardware": {
    "device": "cuda",
    "mixed_precision": "bf16",
    "num_gpus": 1,
    "gradient_accumulation_steps": 1
  },
  "logging": {
    "project": "smolvla-pushcube",
    "entity": null,
    "log_every_n_steps": 10,
    "save_every_n_epochs": 10,
    "eval_every_n_epochs": 5,
    "output_dir": "results/smolvla_finetune",
    "save_best_model": true,
    "best_metric": "eval_success_rate"
  }
}